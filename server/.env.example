NODE_ENV=production
PORT=5000
# MongoDB Atlas: paste your connection string here (also set in your host's dashboard)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vidai
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
# Comma-separated origins allowed to call the API (include your Vercel domain)
CLIENT_URL=http://localhost:3000,https://your-app.vercel.app
# Internal URL of the AI service (set by Railway/Render service names)
AI_SERVICE_URL=http://localhost:8000
ADMIN_EMAIL=admin@vidai.pk
ADMIN_PASSWORD=Admin@123
# Optional: cloudinary://<api_key>:<api_secret>@<cloud_name> — set = uploads go
# to Cloudinary; unset = local disk (fine for dev, lost on redeploys)
CLOUDINARY_URL=
