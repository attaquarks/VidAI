HOST=0.0.0.0
PORT=8000
DEBUG=false

# Hosted inference (production). Requires GOOGLE_API_KEY.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-key-here

# Local inference (development): install Ollama, pull llama3.2:3b, then set
# LLM_PROVIDER=ollama — the service falls back to it automatically.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=300

# Atlas connection string (must match the backend's database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vidai
DB_NAME=vidai

# Comma-separated CORS origins (include your Vercel domain)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
